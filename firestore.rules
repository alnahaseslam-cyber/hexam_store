rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // أي زائر يقدر "يضيف" طلب بس بشكل محدد ومحدود (مفيش قراءة)
      allow create: if request.resource.data.keys().hasOnly(
          ['code','name','phone','phone2','address','note','total','items','status','createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.code is string && request.resource.data.code.size() < 20
        && request.resource.data.name is string && request.resource.data.name.size() < 100
        && request.resource.data.phone is string && request.resource.data.phone.size() == 11
        && request.resource.data.phone2 is string && request.resource.data.phone2.size() <= 11
        && request.resource.data.address is string && request.resource.data.address.size() < 500
        && request.resource.data.note is string && request.resource.data.note.size() < 500
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total < 1000000
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30;

      // القراءة والتعديل والحذف: صاحب المتجر + أي حساب انت ضفته في collection اسمها admins
      allow read, update, delete: if request.auth != null
        && (request.auth.token.email == 'hexam_store@hexam-panel.app'
            || exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
  }
}
